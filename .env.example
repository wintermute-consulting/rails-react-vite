# Copy to .env and fill in. Loaded in development/test by dotenv-rails.

# Site-wide password gate, asked once per browser session and independent from
# user sign-in. Leave unset/blank to disable the gate entirely.
# PASSWORD=

# Action Mailer
MAILER_SENDER=no-reply@example.com

# S3-compatible storage for Active Storage (production).
# Plain AWS S3: set AWS_BUCKET and leave AWS_ENDPOINT_URL_S3 unset.
# Other providers (Tigris, R2, MinIO, …) need the endpoint, and some inject
# BUCKET_NAME instead of AWS_BUCKET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT_URL_S3=
# BUCKET_NAME=

# Active Record connection pool. Defaults to RAILS_MAX_THREADS when unset; set
# it higher than RAILS_MAX_THREADS when Solid Queue workers share the pool.
# DB_POOL=
