# Copy to .env and fill in. Loaded in development/test by dotenv-rails.

# Sidekiq / Active Job
REDIS_URL=redis://localhost:6379/0

# Action Mailer
MAILER_SENDER=no-reply@example.com

# AWS S3 (Active Storage, used in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
